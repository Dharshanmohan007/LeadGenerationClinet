# Backend API base URL including the /api prefix (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Production example:
# VITE_API_BASE_URL=https://lead-gen-server-beta.vercel.app/api

# Set to "true" to verify session state on app boot via GET /api/auth/me
VITE_ENABLE_AUTH_SESSION_CHECK=true

# Optional: configure authorized lending/distribution partner details before production
# VITE_LENDING_PARTNER_NAME=
# VITE_LENDING_PARTNER_NOTICE_URL=
