# Production backend API base URL including the /api prefix (no trailing slash).
# Note: Hosting platform environment variables (such as Vercel Project Settings)
# take precedence over this file during builds.
VITE_API_BASE_URL=https://lead-gen-server-beta.vercel.app/api

# Verify authenticated session on app boot via GET /api/auth/me
VITE_ENABLE_AUTH_SESSION_CHECK=true
